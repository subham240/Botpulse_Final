{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/v1/:path*",
      "destination": "https://refused-them-pharmacology-completion.trycloudflare.com/api/v1/:path*"
    },
    {
      "source": "/health",
      "destination": "https://refused-them-pharmacology-completion.trycloudflare.com/health"
    },
    {
      "source": "/botpulse.js",
      "destination": "https://refused-them-pharmacology-completion.trycloudflare.com/botpulse.js"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}