{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/v1/:path*",
      "destination": "https://clients-johnny-terms-anonymous.trycloudflare.com/api/v1/:path*"
    },
    {
      "source": "/api/:path*",
      "destination": "https://clients-johnny-terms-anonymous.trycloudflare.com/api/:path*"
    },
    {
      "source": "/events",
      "destination": "https://clients-johnny-terms-anonymous.trycloudflare.com/api/v1/events"
    },
    {
      "source": "/telemetry/:path*",
      "destination": "https://clients-johnny-terms-anonymous.trycloudflare.com/api/v1/telemetry/:path*"
    },
    {
      "source": "/health",
      "destination": "https://clients-johnny-terms-anonymous.trycloudflare.com/health"
    },
    {
      "source": "/botpulse.js",
      "destination": "https://clients-johnny-terms-anonymous.trycloudflare.com/botpulse.js"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}