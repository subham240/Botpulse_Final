# =============================================================================
# BotPulse AI Security Engine — Environment Configuration
# =============================================================================

# Public Frontend API URL (Local or Cloudflare Tunnel)
VITE_API_URL=http://127.0.0.1:8000/api/v1

# Security & Decision Signing Secret Key (Minimum 32 characters)
BOTPULSE_SECRET_KEY=replace-with-a-unique-random-secret-at-least-32-chars

# =============================================================================
# Supabase Cloud Database Configuration (100% Free PostgreSQL)
# Get your connection string from:
# Supabase Dashboard -> Project Settings -> Database -> Connection string -> URI
# =============================================================================
# Direct or Session/Transaction Pooler URI:
SUPABASE_DB_URL=postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres

# Optional: Supabase HTTPS API Access (Project Settings -> API)
SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
SUPABASE_KEY=eyJhbGciOi...
